{
  "name": "tmp_init",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install": "echo \"Skipping node-gyp auto-build!\"",
    "start": "vite",
    "start:nw": "nw .",
    "nw": "npm run build:cpp && concurrently \"npm run dev:web\" \"npm run start:nw\"",
    "dev": "start_dev.bat npm run build:cpp && concurrently \"npm run dev:web\" \"npm run dev:server\" \"npm run start:nw\"",
    "dev:web": "vite --port 3000",
    "dev:server": "npm --prefix server run dev",
    "build:cpp": "node build_scripts/build-core.js",
    "clean": "powershell -Command \"Remove-Item -Recurse -Force build, build_wasm, engine/generated, src/generated\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "cmake-js": {
    "arch": "x64",
    "runtime": "node"
  },
  "main": "http://localhost:3000",
  "dependencies": {
    "@most/adapter": "^1.0.0",
    "@most/core": "^1.6.1",
    "@most/scheduler": "^1.3.0",
    "@most/types": "^1.1.0",
    "@reduxjs/toolkit": "^2.11.2",
    "flatbuffers": "^24.12.23",
    "most": "^1.9.0",
    "node-addon-api": "^8.6.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.1",
    "ts-key-enum": "^3.0.13",
    "valtio": "^2.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "cmake-js": "^8.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "nw": "^0.109.0-sdk",
    "sass": "^1.98.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}